<div class="cart-page-wrapper-section">
  <div class="cart-restricted-container">
    <div class="cart-main-title-header">
      <h1>{{ 'cart.title' | t }}</h1>
      <div class="accent-bar"></div>
    </div>

    {% if cart.item_count > 0 %}
      {% assign threshold_cents = 1500000 %}
      <div class="brand-shipping-tracker-card-box">
        {% if cart.total_price < threshold_cents %}
          {% assign amount_left = threshold_cents | minus: cart.total_price %}
          <div class="tracker-text-row">
            You are only <strong>{{ amount_left | money }}</strong> away from unlocking <strong>Free Ocean Shipping</strong>!
          </div>
          <div class="tracker-progress-bar-rail">
            {% assign percentage = cart.total_price | times: 100 | divided_by: threshold_cents %}
            <div class="tracker-progress-bar-fill" style="width: {{ percentage }}%;"></div>
          </div>
        {% else %}
          <div class="tracker-text-row success-unlocked">
            🎉 <strong>Congratulations!</strong> Your crate profile has qualified for Free Ocean Shipping.
          </div>
          <div class="tracker-progress-bar-rail">
            <div class="tracker-progress-bar-fill unlocked" style="width: 100%;"></div>
          </div>
        {% endif %}
      </div>

      <form action="{{ routes.cart_url }}" method="post" class="cart-form-split-grid">
        <div class="cart-items-panel">
          <div class="premium-cart-list">
            {% for item in cart.items %}
              <div class="cart-item-row-card">
                <div class="cell-thumb">
                  <div class="thumb-frame">
                    {% render 'image', image: item.image, url: item.url %}
                  </div>
                </div>
                <div class="cell-meta">
                  <p class="item-title-str">{{ item.product.title }}</p>
                  <p class="item-price-str">{{ item.final_price | money }}</p>
                  <span class="remove-action-btn-link">{{ 'cart.remove' | t | link_to: item.url_to_remove }}</span>
                </div>
                <div class="cell-actions">
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="qty-field-box">
                  <input type="submit" value="{{ 'cart.update' | t }}" class="cart-sync-refresh-btn">
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="cart-checkout-summary-panel">
          <div class="checkout-summary-box">
            <div class="brand-travel-tip-notice-box">
              <span class="tip-label-badge">Nomad Travel Tip</span>
              <p>Packing compression cubes inside your structural technical case layout decreases volume footprints by up to 30% instantly.</p>
            </div>
            <div class="subtotal-row-display">
              <span class="label">Aggregate Subtotal:</span>
              <span class="value">{{ cart.total_price | money }}</span>
            </div>
            <input type="submit" name="checkout" value="Secure Order Checkout" class="cart-checkout-master-cta-btn">
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart-empty-fallback-state">
        <p>Your packing crate configuration is empty.</p>
        <a href="/collections/all" class="return-btn">Explore Crate Store</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .cart-restricted-container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    box-sizing: border-box;
  }
  .cart-main-title-header { text-align: center; margin-bottom: 2.5rem; }
  .cart-main-title-header h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: #0f172a;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }
  .cart-main-title-header .accent-bar {
    width: 48px;
    height: 4px;
    background: #ff6b00;
    margin: 0 auto;
    border-radius: 10px;
  }
  .brand-shipping-tracker-card-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 2.5rem;
    box-sizing: border-box;
  }
  .tracker-text-row { font-size: 0.9rem; color: #334155; margin-bottom: 0.5rem; line-height: 1.4; }
  .tracker-text-row strong { color: #ff6b00; }
  .tracker-text-row.success-unlocked strong { color: #22c55e; }
  .tracker-progress-bar-rail { width: 100%; height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; }
  .tracker-progress-bar-fill { height: 100%; background: #ff6b00; transition: width 0.4s ease; }
  .tracker-progress-bar-fill.unlocked { background: #22c55e; }

  .cart-form-split-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: flex-start;
  }
  .premium-cart-list { display: flex; flex-direction: column; gap: 1rem; }
  .cart-item-row-card {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: #ffffff;
  }
  .thumb-frame {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }
  .thumb-frame img { width: 100%; height: 100%; object-fit: cover; }
  .cell-meta { flex-grow: 1; min-width: 0; }
  .item-title-str { font-weight: 600; color: #1e293b; margin: 0 0 0.25rem 0; font-size: 0.95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .item-price-str { color: #ff6b00; font-weight: 700; margin: 0 0 0.4rem 0; font-size: 0.9rem; }
  .remove-action-btn-link a { color: #94a3b8; font-size: 0.75rem; text-decoration: none; font-weight: 700; text-transform: uppercase; }
  .remove-action-btn-link a:hover { color: #ef4444; }
  
  .cell-actions { display: flex; align-items: center; gap: 0.5rem; }
  .qty-field-box {
    width: 55px;
    padding: 0.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    background: #f8fafc;
    text-align: center;
    font-weight: 600;
  }
  .cart-sync-refresh-btn {
    padding: 0.5rem 0.75rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #475569;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .checkout-summary-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 1.5rem; box-sizing: border-box; }
  .brand-travel-tip-notice-box { background: #ffffff; border: 1px solid #e2e8f0; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; border-left: 3px solid #ff6b00; }
  .tip-label-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #ff6b00; display: block; margin-bottom: 0.25rem; }
  .brand-travel-tip-notice-box p { margin: 0; font-size: 0.8rem; color: #475569; line-height: 1.4; }
  .subtotal-row-display { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; border-top: 1px solid #e2e8f0; padding-top: 1rem; }
  .subtotal-row-display .label { font-weight: 700; color: #0f172a; font-size: 0.95rem; }
  .subtotal-row-display .value { color: #ff6b00; font-weight: 800; font-size: 1.25rem; }
  .cart-checkout-master-cta-btn { width: 100%; padding: 1rem; border: none; background: #0f172a; color: #ffffff; border-radius: 8px; font-weight: 700; font-size: 0.95rem; cursor: pointer; }
  .cart-empty-fallback-state { text-align: center; padding: 4rem 0; }
  .return-btn { display: inline-block; background: #0f172a; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600; margin-top: 1rem; }

  @media (max-width: 840px) {
    .cart-form-split-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 520px) {
    .cart-item-row-card { flex-direction: column; align-items: flex-start; gap: 1rem; position: relative; }
    .cell-thumb { width: 60px; height: 60px; }
    .cell-actions { width: 100%; justify-content: space-between; border-top: 1px dashed #e2e8f0; padding-top: 0.75rem; }
    .qty-field-box { width: 65px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart Monitor Matrix",
  "settings": []
}
{% endschema %}