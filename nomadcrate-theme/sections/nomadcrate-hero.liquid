<section class="nc-hero-section section-{{ section.id }}" aria-label="NomadCrate Advanced Hero">
  <div class="nc-hero-media-vault">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2200 | image_tag: 
        loading: 'eager', 
        sizes: '100vw', 
        widths: '375, 550, 750, 1100, 1500, 1780, 2200',
        class: 'nc-hero-img-asset'
      }}
    {%- else -%}
      <img 
        src="https://images.unsplash.com/photo-1501555088652-021faa106b9b?auto=format&fit=crop&w=2200&q=80" 
        class="nc-hero-img-asset" 
        loading="eager" 
        alt="NomadCrate Premium Adventure Background"
      >
    {%- endif -%}
    <div class="nc-hero-cinematic-overlay"></div>
  </div>

  <div class="nc-hero-viewport">
    <div class="nc-hero-master-grid">
      
      <div class="nc-hero-narrative">
        {%- if section.settings.tagline != blank -%}
          <div class="nc-hero-badge animate-item">
            <span class="nc-badge-dot"></span>
            <span class="nc-badge-text">{{ section.settings.tagline | escape }}</span>
          </div>
        {%- endif -%}

        <h1 class="nc-hero-editorial-title animate-item">
          <span class="nc-title-light">{{ section.settings.title_part_1 }}</span>
          <span class="nc-title-bold">{{ section.settings.title_part_2 }}</span>
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="nc-hero-paragraph animate-item">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
          <div class="nc-hero-cta-group animate-item">
            <a href="{{ section.settings.btn_link }}" class="nc-btn-primary">
              <span class="nc-btn-label">{{ section.settings.btn_label | escape }}</span>
              <span class="nc-btn-arrow-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="nc-hero-interactive-wing">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'spotlight_card' -%}
              <div class="nc-glass-card animate-card" {{ block.shopify_attributes }}>
                {%- if block.settings.card_image != blank -%}
                  <div class="nc-card-thumb">
                    {{ block.settings.card_image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'nc-thumb-asset' }}
                  </div>
                {%- endif -%}
                <div class="nc-card-details">
                  <span class="nc-card-tag">{{ block.settings.card_tag | escape }}</span>
                  <h3 class="nc-card-heading">{{ block.settings.card_title | escape }}</h3>
                  {%- if block.settings.card_link != blank -%}
                    <a href="{{ block.settings.card_link }}" class="nc-card-action-link">
                      {{ block.settings.card_link_label | escape }} 
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.nc-hero-section {
  position: relative;
  height: 100vh;
  height: 100svh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: #0f1115;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.nc-hero-media-vault {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.nc-hero-img-asset {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  animation: ncScaleKenBurns 28s ease-out forwards;
}

.nc-hero-cinematic-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to right,
    rgba(15, 17, 21, 0.9) 0%,
    rgba(15, 17, 21, 0.7) 45%,
    rgba(15, 17, 21, 0.3) 100%
  );
}

.nc-hero-viewport {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 3rem;
  position: relative;
  z-index: 2;
  max-height: 100%;
  display: flex;
  align-items: center;
}

.nc-hero-master-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 4rem;
  align-items: center;
  width: 100%;
}

.nc-hero-narrative {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.nc-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 8px 16px;
  border-radius: 100px;
  margin-bottom: 2rem;
  backdrop-filter: blur(8px);
}

.nc-badge-dot {
  width: 6px;
  height: 6px;
  background-color: #d97706; /* Sunset Amber */
  border-radius: 50%;
  box-shadow: 0 0 12px rgba(217, 119, 6, 0.8);
  animation: ncPulseBeacon 2.5s infinite;
}

.nc-badge-text {
  color: #f8fafc;
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.nc-hero-editorial-title {
  color: #ffffff;
  line-height: 1.1;
  margin: 0 0 1.5rem 0;
  display: flex;
  flex-direction: column;
}

.nc-title-light {
  font-size: clamp(2.5rem, 4.5vw, 4.5rem);
  font-weight: 300;
  color: #e2e8f0;
  font-family: "Playfair Display", "Didot", "Georgia", serif;
  font-style: italic;
  letter-spacing: -0.01em;
}

.nc-title-bold {
  font-size: clamp(2.8rem, 5vw, 5.5rem);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.03em;
  background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.nc-hero-paragraph {
  color: #cbd5e1;
  font-size: clamp(1.05rem, 1.5vw, 1.15rem);
  line-height: 1.6;
  max-width: 500px;
  margin: 0 0 2.5rem 0;
  font-weight: 400;
}

.nc-btn-primary {
  display: inline-flex;
  align-items: center;
  background-color: #ffffff;
  color: #0f1115;
  text-decoration: none;
  padding: 6px 6px 6px 32px;
  border-radius: 100px;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.nc-btn-arrow-wrapper {
  width: 42px;
  height: 42px;
  background-color: #d97706; /* Sunset Amber */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  margin-left: 24px;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.nc-btn-arrow-wrapper svg {
  width: 18px;
  height: 18px;
  transition: transform 0.3s ease;
}

.nc-btn-primary:hover {
  background-color: #f8fafc;
  transform: translateY(-2px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

.nc-btn-primary:hover .nc-btn-arrow-wrapper {
  transform: translateX(4px);
}

.nc-hero-interactive-wing {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.nc-glass-card {
  background: rgba(20, 20, 25, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 1.5rem;
  border-radius: 16px;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  max-width: 380px;
  width: 100%;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  transform: translateY(0);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.nc-glass-card:hover {
  transform: translateY(-8px);
  border-color: rgba(255, 255, 255, 0.25);
  background: rgba(30, 30, 35, 0.45);
  box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.6);
}

.nc-card-thumb {
  width: 85px;
  height: 85px;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
}

.nc-thumb-asset {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.nc-glass-card:hover .nc-thumb-asset {
  transform: scale(1.05);
}

.nc-card-details {
  display: flex;
  flex-direction: column;
}

.nc-card-tag {
  color: #d97706; /* Sunset Amber */
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}

.nc-card-heading {
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  margin: 0 0 10px 0;
  line-height: 1.3;
}

.nc-card-action-link {
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: color 0.2s ease;
}

.nc-card-action-link svg {
  transition: transform 0.2s ease;
}

.nc-glass-card:hover .nc-card-action-link {
  color: #ffffff;
}

.nc-glass-card:hover .nc-card-action-link svg {
  transform: translateX(4px);
}

/* Animations */
@keyframes ncScaleKenBurns {
  from { transform: scale(1.08); }
  to { transform: scale(1.0); }
}

@keyframes ncPulseBeacon {
  0% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.7); }
  70% { box-shadow: 0 0 0 6px rgba(217, 119, 6, 0); }
  100% { box-shadow: 0 0 0 0 rgba(217, 119, 6, 0); }
}

.animate-item {
  opacity: 0;
  transform: translateY(30px);
  animation: ncSlideUpFade 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.nc-hero-narrative .animate-item:nth-child(1) { animation-delay: 0.1s; }
.nc-hero-narrative .animate-item:nth-child(2) { animation-delay: 0.25s; }
.nc-hero-narrative .animate-item:nth-child(3) { animation-delay: 0.4s; }
.nc-hero-narrative .animate-item:nth-child(4) { animation-delay: 0.55s; }

.animate-card {
  opacity: 0;
  transform: translateY(20px);
  animation: ncCardSlideIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
}

@keyframes ncSlideUpFade {
  to { opacity: 1; transform: translateY(0); }
}

@keyframes ncCardSlideIn {
  to { opacity: 1; transform: translateY(0); }
}

/* Responsive Overrides */
@media screen and (max-width: 1100px) {
  .nc-hero-master-grid {
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
  }
}

@media screen and (max-width: 992px) {
  .nc-hero-section {
    height: 100vh;
    height: 100svh;
    padding-top: 0;
  }
  
  .nc-hero-cinematic-overlay {
    background: linear-gradient(
      180deg,
      rgba(15, 17, 21, 0.8) 0%,
      rgba(15, 17, 21, 0.6) 50%,
      rgba(15, 17, 21, 0.9) 100%
    );
  }

  .nc-hero-viewport {
    padding: 2rem;
  }

  .nc-hero-master-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
    text-align: center;
  }

  .nc-hero-narrative {
    align-items: center;
  }

  .nc-hero-editorial-title {
    align-items: center;
    margin-bottom: 1.2rem;
  }
  
  .nc-hero-paragraph {
    margin-bottom: 2rem;
  }

  .nc-hero-interactive-wing {
    justify-content: center;
  }
  
  .nc-glass-card {
    max-width: 420px;
  }
}

@media screen and (max-width: 480px) {
  .nc-hero-viewport {
    padding: 1.5rem;
  }
  
  .nc-btn-primary {
    width: 100%;
    justify-content: space-between;
  }

  .nc-glass-card {
    padding: 1.25rem;
    gap: 1rem;
  }

  .nc-card-thumb {
    width: 75px;
    height: 75px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "NomadCrate Advanced Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Hero Background Image Layout"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Small Tagline Label",
      "default": "Premium Travel Equipment"
    },
    {
      "type": "text",
      "id": "title_part_1",
      "label": "Editorial Font Line (Italic)",
      "default": "Travel Smarter."
    },
    {
      "type": "text",
      "id": "title_part_2",
      "label": "Impact Bold Line",
      "default": "Pack Better."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Context Subheading Description",
      "default": "Highly optimized dynamic luggage and storage configurations engineered for the modern technical explorer."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Call To Action Text",
      "default": "Explore Essentials"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Call To Action Target Destination",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "spotlight_card",
      "name": "Floating Feature Card",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Featured Item Miniature Image"
        },
        {
          "type": "text",
          "id": "card_tag",
          "label": "Small Highlight Tag",
          "default": "Trending Highlight"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Product System Title",
          "default": "Modular Tech Crate v2"
        },
        {
          "type": "text",
          "id": "card_link_label",
          "label": "Action Text Link",
          "default": "Configure Bundle"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Product Core Destination URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NomadCrate Advanced Hero",
      "blocks": [
        {
          "type": "spotlight_card"
        }
      ]
    }
  ]
}
{% endschema %}