<section class="trust-banner">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item">
        <img src="https://images.unsplash.com/photo-1622560480605-d83c853bc5c3?auto=format&fit=crop&w=150&q=80" alt="Global Delivery" class="trust-icon" loading="lazy">
        <h4>Global Delivery</h4>
        <p>Free shipping on orders over $150</p>
      </div>
      <div class="trust-item">
        <img src="https://images.unsplash.com/photo-1584433144859-1fc3ab64a957?auto=format&fit=crop&w=150&q=80" alt="Lifetime Warranty" class="trust-icon" loading="lazy">
        <h4>Lifetime Warranty</h4>
        <p>Built to outlast your toughest journey</p>
      </div>
      <div class="trust-item">
        <img src="https://images.unsplash.com/photo-1607523992257-22f28189c9e8?auto=format&fit=crop&w=150&q=80" alt="Easy Returns" class="trust-icon" loading="lazy">
        <h4>Easy Returns</h4>
        <p>30-day hassle-free global exchanges</p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.trust-banner {
  padding: 4rem 2rem;
  background: #090d16; /* Matches your Hero background */
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  border-top: 1px solid rgba(255,255,255,0.05);
}

.trust-banner .container { 
  max-width: 1200px; 
  margin: 0 auto; 
}

.trust-banner .trust-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 3rem;
  text-align: center;
}

.trust-banner .trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.3s ease;
}

.trust-banner .trust-item:hover {
  transform: translateY(-5px);
}

.trust-banner .trust-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 1.5rem;
  border: 2px solid rgba(249, 115, 22, 0.5); /* Subtle orange border */
  padding: 4px;
  background: rgba(255,255,255,0.05);
}

.trust-banner h4 { 
  font-size: 1.15rem; 
  font-weight: 700; 
  margin: 0 0 0.5rem 0; 
  letter-spacing: -0.01em;
}

.trust-banner p { 
  font-size: 0.95rem; 
  color: #94a3b8; 
  margin: 0;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .trust-banner .trust-grid {
    gap: 2.5rem;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Banner",
  "presets": [
    {
      "name": "Trust Banner"
    }
  ]
}
{% endschema %}