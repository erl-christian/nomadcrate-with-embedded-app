<section class="nc-travel-categories section-{{ section.id }}">
  <div class="nc-container">
    <div class="nc-section-header animate-fade-in">
      <span class="nc-section-subtitle">Curated Routes</span>
      <h2 class="nc-section-title">{{ section.settings.heading }}</h2>
      <p class="nc-section-desc">{{ section.settings.subheading }}</p>
    </div>

    <!-- Drag-to-Scroll Track -->
    <div class="nc-category-slider-track" id="categorySlider-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="nc-category-card" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="nc-category-link-wrapper">
            
            <div class="nc-category-image-vault">
              <div class="nc-img-scale-wrapper">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag: class: 'nc-category-img', loading: 'lazy'
                  }}
                {% else %}
                  {% capture placeholder_index %}{% cycle 'lifestyle-1', 'lifestyle-2', 'collection-1' %}{% endcapture %}
                  {{ placeholder_index | placeholder_svg_tag: 'nc-category-img placeholder-svg' }}
                {% endif %}
              </div>
              <!-- Premium Dark Overlay for text contrast if you ever move text inside -->
              <div class="nc-category-overlay"></div>
            </div>

            <div class="nc-category-content">
              <div class="nc-category-text">
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
              
              <div class="nc-category-action">
                <span class="nc-action-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </span>
              </div>
            </div>

          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.nc-travel-categories {
  padding: 8rem 0; /* Removed side padding to let the slider bleed to the edge */
  background: #ffffff;
  overflow: hidden; /* Prevent horizontal page scroll */
}

.nc-travel-categories .nc-container {
  max-width: 1560px;
  margin: 0 auto;
  padding: 0 3rem;
}

.nc-section-header {
  margin-bottom: 4rem;
  max-width: 600px;
}

.nc-section-subtitle {
  color: #ff6b00;
  font-size: 0.8rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  display: block;
  margin-bottom: 1rem;
}

.nc-section-title {
  font-size: clamp(2.5rem, 4vw, 4rem);
  font-weight: 900;
  color: #0b0f19;
  margin: 0 0 1rem 0;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.nc-section-desc {
  color: #64748b;
  font-size: 1.15rem;
  line-height: 1.6;
  margin: 0;
}

/* Draggable Slider Engine */
.nc-category-slider-track {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  gap: 2.5rem;
  padding: 1rem 3rem 4rem 3rem; /* Extra bottom padding for drop shadows */
  margin: 0 -3rem; /* Negative margin pulls it to the container edge */
  
  /* Smooth Snapping */
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  
  /* App-like hiding of scrollbar */
  scrollbar-width: none;
  cursor: grab;
}

.nc-category-slider-track::-webkit-scrollbar {
  display: none;
}

.nc-category-slider-track:active {
  cursor: grabbing;
}

/* Premium Card Styling */
.nc-category-card {
  flex: 0 0 calc(33.333% - 1.66rem); /* 3 cards perfectly visible */
  scroll-snap-align: start;
  min-width: 350px;
  background: #ffffff;
  border-radius: 20px;
  border: 1px solid rgba(226, 232, 240, 0.6);
  box-shadow: 0 10px 30px rgba(11, 15, 25, 0.03);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  transform: translateZ(0); /* Hardware accel */
}

.nc-category-link-wrapper {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  height: 100%;
}

.nc-category-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 25px 50px rgba(11, 15, 25, 0.08);
  border-color: rgba(255, 107, 0, 0.3);
}

.nc-category-image-vault {
  width: 100%;
  height: 340px;
  overflow: hidden;
  position: relative;
  border-radius: 20px 20px 0 0;
  background: #f1f5f9;
}

.nc-img-scale-wrapper {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.nc-category-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Ken Burns effect on hover */
.nc-category-card:hover .nc-category-img {
  transform: scale(1.08);
}

.nc-category-content {
  padding: 2.5rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  flex-grow: 1;
}

.nc-category-text h3 {
  color: #0b0f19;
  font-size: 1.5rem;
  font-weight: 800;
  margin: 0 0 0.5rem 0;
  transition: color 0.3s ease;
}

.nc-category-text p {
  color: #64748b;
  font-size: 1rem;
  line-height: 1.6;
  margin: 0;
}

.nc-category-card:hover .nc-category-text h3 {
  color: #ff6b00;
}

/* Magnetic Action Button */
.nc-category-action {
  flex-shrink: 0;
  margin-left: 1.5rem;
}

.nc-action-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0b0f19;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1px solid #e2e8f0;
}

.nc-category-card:hover .nc-action-icon {
  background: #0b0f19;
  color: #ffffff;
  transform: rotate(-45deg) scale(1.1);
  border-color: #0b0f19;
  box-shadow: 0 10px 20px rgba(11, 15, 25, 0.15);
}

/* Responsive Rules */
@media (max-width: 1200px) {
  .nc-category-card { flex: 0 0 calc(45% - 1rem); }
}

@media (max-width: 840px) {
  .nc-travel-categories { padding: 5rem 0; }
  .nc-travel-categories .nc-container { padding: 0 1.5rem; }
  .nc-section-header { text-align: center; margin: 0 auto 3rem auto; }
  
  .nc-category-slider-track {
    padding: 1rem 1.5rem 3rem 1.5rem;
    margin: 0 -1.5rem;
    gap: 1.5rem;
  }
  
  .nc-category-card { 
    flex: 0 0 85%; /* Shows a peek of the next card to encourage scrolling */
    scroll-snap-align: center; 
    min-width: 280px;
  }
  
  .nc-category-image-vault { height: 280px; }
  .nc-category-content { padding: 1.5rem; }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const sliders = document.querySelectorAll('.nc-category-slider-track');

  sliders.forEach(slider => {
    let isDown = false;
    let startX;
    let scrollLeft;
    let isDragging = false;

    // Prevent link click if the user was just dragging
    slider.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', (e) => {
        if (isDragging) {
          e.preventDefault();
        }
      });
    });

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false;
      slider.style.cursor = 'grabbing';
      slider.style.scrollSnapType = 'none'; // Disable snapping during drag for smoother feel
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      isDown = false;
      slider.style.cursor = 'grab';
      slider.style.scrollSnapType = 'x mandatory';
    });

    slider.addEventListener('mouseup', () => {
      isDown = false;
      slider.style.cursor = 'grab';
      slider.style.scrollSnapType = 'x mandatory';
      
      // Reset isDragging after a slight delay so the click event can evaluate it
      setTimeout(() => {
        isDragging = false;
      }, 50);
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      isDragging = true;
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2; // Scroll speed multiplier
      slider.scrollLeft = scrollLeft - walk;
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Travel Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Adventure"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated travel essentials for every journey."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Beach Travel"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Sun, sand, and seamless packing."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Travel Categories"
    }
  ]
}
{% endschema %}