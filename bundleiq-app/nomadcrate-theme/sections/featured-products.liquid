<section class="featured-products">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Gear Spotlights</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    {% assign featured_collection = section.settings.featured_collection %}

    {% if featured_collection != blank and featured_collection.all_products_count > 0 %}
      <div class="products-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <div class="product-card">
            <a href="{{ product.url }}" class="product-image-link">
              <div class="product-image-container">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag: class: 'product-image', loading: 'lazy'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'product-image placeholder-svg' }}
                {% endif %}
              </div>

              {% if product.available %}
                <span class="stock-badge">In Stock</span>
              {% else %}
                <span class="stock-badge sold-out">Sold Out</span>
              {% endif %}
            </a>

            <div class="product-content">
              <span class="product-vendor">{{ product.vendor }}</span>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

              <div class="product-footer-row">
                {% if product.compare_at_price > product.price %}
                  <div class="product-pricing">
                    <span class="sale-price">{{ product.price | money }}</span>
                    <span class="compare-price">{{ product.compare_at_price | money }}</span>
                  </div>
                {% else %}
                  <p class="product-price">{{ product.price | money }}</p>
                {% endif %}

                <a href="{{ product.url }}" class="product-btn" aria-label="View {{ product.title }}">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <div class="empty-state-icon">📦</div>
        <h3>No Collection Selected</h3>
        <p>Assign a collection inside the Theme Editor settings panel to map out items.</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.featured-products {
  padding: 7rem 2rem;
  background: #f8fafc;
  border-top: 1px solid #f1f5f9;
}

.featured-products .container {
  max-width: 1300px;
  margin: 0 auto;
}

.featured-products .section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.featured-products .section-subtitle {
  color: #ff6b00;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  display: block;
  margin-bottom: 0.5rem;
}

.featured-products .section-header h2 {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.featured-products .section-header p {
  color: #64748b;
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto;
}

.featured-products .products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.featured-products .product-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
}

.featured-products .product-card:hover {
  transform: translateY(-6px);
  border-color: #cbd5e1;
  box-shadow: 0 15px 30px rgba(15, 23, 42, 0.03);
}

.featured-products .product-image-link {
  position: relative;
  display: block;
  background: #f8fafc;
  overflow: hidden;
}

.featured-products .product-image-container {
  width: 100%;
  height: 280px;
}

.featured-products .product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.featured-products .product-card:hover .product-image {
  transform: scale(1.03);
}

.featured-products .stock-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  background: rgba(255, 255, 255, 0.9);
  color: #1e293b;
  border: 1px solid #e2e8f0;
  padding: 0.3rem 0.65rem;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  backdrop-filter: blur(4px);
}

.featured-products .stock-badge.sold-out {
  color: #94a3b8;
  background: rgba(241, 245, 249, 0.9);
}

.featured-products .product-content {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.featured-products .product-vendor {
  display: block;
  color: #94a3b8;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.4rem;
}

.featured-products .product-content h3 {
  font-size: 1.05rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  line-height: 1.4;
  flex-grow: 1;
}

.featured-products .product-content h3 a {
  color: #1e293b;
  text-decoration: none;
}

.featured-products .product-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.featured-products .product-pricing {
  display: flex;
  gap: 0.5rem;
  align-items: baseline;
}

.featured-products .sale-price {
  color: #ff6b00;
  font-weight: 700;
  font-size: 1.15rem;
}

.featured-products .compare-price {
  color: #94a3b8;
  text-decoration: line-through;
  font-size: 0.9rem;
}

.featured-products .product-price {
  color: #1e293b;
  font-weight: 700;
  font-size: 1.15rem;
  margin: 0;
}

.featured-products .product-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f172a;
  color: #ffffff;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  transition: all 0.3s ease;
  text-decoration: none;
}

.featured-products .product-card:hover .product-btn {
  background: #ff6b00;
  transform: scale(1.05);
}

.featured-products .empty-state {
  text-align: center;
  padding: 4rem 2rem;
  background: #ffffff;
  border: 1px dashed #e2e8f0;
  border-radius: 16px;
}

@media (max-width: 1100px) {
  .featured-products .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .featured-products .products-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Traveler Favorites"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Essential gear for every journey."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}