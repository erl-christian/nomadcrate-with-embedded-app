<section class="travel-categories">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">Curated Routes</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="category-grid">
      {% for block in section.blocks %}
        <div class="category-card" {{ block.shopify_attributes }}>
          <div class="category-image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag: class: 'category-image', loading: 'lazy'
              }}
            {% else %}
              {% capture placeholder_index %}{% cycle 'lifestyle-1', 'lifestyle-2', 'collection-1' %}{% endcapture %}
              {{ placeholder_index | placeholder_svg_tag: 'category-image placeholder-svg' }}
            {% endif %}
          </div>

          <div class="category-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="category-btn">
                <span>Explore Gear</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            {% else %}
              <a href="#" class="category-btn">
                <span>Explore Gear</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.travel-categories {
  padding: 7rem 2rem;
  background: #ffffff;
}

.travel-categories .container {
  max-width: 1300px;
  margin: 0 auto;
}

.travel-categories .section-header {
  text-align: center;
  margin-bottom: 4rem;
}

.travel-categories .section-subtitle {
  color: #ff6b00;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  display: block;
  margin-bottom: 0.5rem;
}

.travel-categories .section-header h2 {
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}

.travel-categories .section-header p {
  color: #64748b;
  font-size: 1.1rem;
  max-width: 600px;
  margin: 0 auto;
}

.travel-categories .category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}

.travel-categories .category-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.travel-categories .category-card:hover {
  transform: translateY(-8px);
  border-color: #ff6b00;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
}

.travel-categories .category-image-wrapper {
  width: 100%;
  height: 280px;
  overflow: hidden;
  position: relative;
  background: #f8fafc;
}

.travel-categories .category-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.travel-categories .category-card:hover .category-image {
  transform: scale(1.04);
}

.travel-categories .category-content {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.travel-categories .category-content h3 {
  color: #0f172a;
  font-size: 1.35rem;
  font-weight: 700;
  margin: 0 0 0.5rem 0;
}

.travel-categories .category-content p {
  color: #64748b;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 1.75rem;
  flex-grow: 1;
}

.travel-categories .category-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: #0f172a;
  font-weight: 700;
  font-size: 0.9rem;
  text-decoration: none;
  transition: color 0.3s ease;
  align-self: flex-start;
}

.travel-categories .category-btn svg {
  color: #ff6b00;
  transition: transform 0.3s ease;
}

.travel-categories .category-card:hover .category-btn {
  color: #ff6b00;
}

.travel-categories .category-card:hover .category-btn svg {
  transform: translateX(4px);
}

@media (max-width: 1024px) {
  .travel-categories .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .travel-categories .category-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Travel Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Adventure"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated travel essentials for every journey."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Beach Travel"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Sun, sand, and seamless packing."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Travel Categories"
    }
  ]
}
{% endschema %}